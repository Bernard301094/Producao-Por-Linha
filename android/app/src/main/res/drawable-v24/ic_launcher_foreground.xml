<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

  <!-- Hexagon outline outer -->
  <path
      android:pathData="M256,100 L390,177 L390,335 L256,412 L122,335 L122,177 Z"
      android:fillColor="#00000000"
      android:strokeColor="#334155"
      android:strokeWidth="6"
      android:strokeAlpha="0.4"/>

  <!-- Hexagon outline inner -->
  <path
      android:pathData="M256,120 L372,188 L372,324 L256,392 L140,324 L140,188 Z"
      android:fillColor="#00000000"
      android:strokeColor="#475569"
      android:strokeWidth="2"
      android:strokeAlpha="0.2"/>

  <!-- Gold checkmark -->
  <path
      android:pathData="M168,276 L236,344 L360,176"
      android:fillColor="#00000000"
      android:strokeWidth="40"
      android:strokeLineCap="round"
      android:strokeLineJoin="round">
    <aapt:attr name="android:strokeColor">
      <gradient
          android:startX="168"
          android:startY="344"
          android:endX="360"
          android:endY="176"
          android:type="linear">
        <item android:offset="0" android:color="#FFB45309"/>
        <item android:offset="0.4" android:color="#FFF59E0B"/>
        <item android:offset="1" android:color="#FFFDE68A"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- Glow circle at tip -->
  <path
      android:pathData="M360,176 m-20,0 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0"
      android:fillColor="#FEF3C7"/>

</vector>