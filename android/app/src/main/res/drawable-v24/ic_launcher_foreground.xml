<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <!-- Hexagon outline -->
  <path
      android:pathData="M54 18 L82 33 V63 L54 78 L26 63 V33 Z"
      android:strokeColor="#334155"
      android:strokeWidth="1.5"
      android:fillColor="#00000000"
      android:strokeAlpha="0.5"/>

  <!-- Checkmark with gold gradient -->
  <path
      android:pathData="M32 57 L46 71 L76 35"
      android:strokeWidth="9"
      android:strokeLineCap="round"
      android:strokeLineJoin="round"
      android:fillColor="#00000000">
    <aapt:attr name="android:strokeColor">
      <gradient
          android:startX="32"
          android:startY="71"
          android:endX="76"
          android:endY="35"
          android:type="linear">
        <item android:offset="0" android:color="#B45309"/>
        <item android:offset="0.4" android:color="#F59E0B"/>
        <item android:offset="1" android:color="#FDE68A"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- Tip glow circle -->
  <path
      android:pathData="M76,35 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
      android:fillColor="#FEF3C7"/>

</vector>