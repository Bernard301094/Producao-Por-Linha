rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$'); }

    function isValidPendingOperation(data) {
      return data.keys().hasAll(['opNumber', 'litragem', 'produto', 'linha', 'turno', 'horaInicial', 'carimboInicial', 'localId']);
    }

    match /pendingOperations/{opId} {
      allow read, list: if true;
      allow create: if isValidId(opId) && isValidPendingOperation(request.resource.data);
      allow update, delete: if true;
    }

    // Regla añadida para solucionar el error de permisos
    match /finishedOperations/{opId} {
      allow read, list, create, update, delete: if true;
    }

    match /products/{prodId} {
      allow read, list, create, update, delete: if true;
    }

    match /reports/{reportId} {
      allow read, list, create, update, delete: if true;
    }

    match /authProfiles/{profileId} {
      allow read, list, create: if true;
      allow update: if true;
      allow delete: if false;
    }
  }
}
